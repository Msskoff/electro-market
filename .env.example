# URL publique du site (sans slash final) — utilisée pour canonical, sitemap, JSON-LD
NEXT_PUBLIC_SITE_URL=https://www.votre-domaine.com
# Devise ISO 4217
NEXT_PUBLIC_CURRENCY=XOF
# Indexation Google / assistants IA : laisser vide (démo) ; "true" uniquement au lancement réel
SITE_INDEXING=
# Paiement : Moov Money, Mixx by Yas et paiement à la livraison, configurés dans /admin/configuration (aucune clé).
# Supabase (authentification + espace client). Clé « publishable » (sb_publishable_…) : publique, protégée par la RLS.
# Ne JAMAIS mettre ici la clé « secret » / service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Mesure d'audience anonyme (statistiques /admin)
# Sel secret de l'empreinte quotidienne des visiteurs : chaîne aléatoire longue, uniquement sur Vercel.
ANALYTICS_SALT=
# 1 = ne rien enregistrer (machine locale, tests). Ne pas définir en production.
ANALYTICS_DISABLED=1

# Tests de bout en bout connectés (npm run test:e2e) : compte de TEST dédié, jamais un compte réel.
E2E_EMAIL=
E2E_PASSWORD=
