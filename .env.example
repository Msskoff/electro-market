# URL publique du site (sans slash final) — utilisée pour canonical, sitemap, JSON-LD
NEXT_PUBLIC_SITE_URL=https://www.votre-domaine.com
# Devise ISO 4217
NEXT_PUBLIC_CURRENCY=XOF
# Indexation Google / assistants IA : laisser vide (démo) ; "true" uniquement au lancement réel
SITE_INDEXING=
# Prestataire de paiement (stripe | paypal | ...) — non branché dans le MVP
PAYMENT_PROVIDER=
